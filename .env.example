# Copy this file to ".env" and fill in real values. NEVER commit the real .env.
# The Gmail account whose App Password is used to authenticate with SMTP.
EMAIL_USER=your-sender@gmail.com
# A Google App Password (16 chars). Generate at https://myaccount.google.com/apppasswords
# Spaces are fine — they're stripped automatically.
EMAIL_PASS=xxxx xxxx xxxx xxxx
# Where contact-form submissions are delivered (your inbox).
MAIL_TO=you@gmail.com
# Comma-separated list of sites allowed to call this API (no trailing slash).
ALLOWED_ORIGINS=https://johnwick-400.github.io,http://localhost:8000,http://127.0.0.1:8000
# Port for local runs. Hosts like Render/Railway set this for you.
PORT=3000
