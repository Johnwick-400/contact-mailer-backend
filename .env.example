# Copy this file to ".env" and fill in real values. NEVER commit the real .env.
# Brevo (transactional email) API key — Brevo dashboard → SMTP & API → API Keys.
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxx
# Inbox that receives contact-form submissions.
MAIL_TO=you@gmail.com
MAIL_TO_NAME=Your Name
# Sender shown on the email. MUST be a verified sender/domain in Brevo.
MAIL_FROM_EMAIL=verified-sender@gmail.com
MAIL_FROM_NAME=Portfolio Contact
# Comma-separated sites allowed to call this API (no trailing slash).
ALLOWED_ORIGINS=https://johnwick-400.github.io
# Port for local runs. Hosts like Render set this for you.
PORT=3000
